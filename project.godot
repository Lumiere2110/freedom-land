; Godot のプロジェクト設定ファイルです。
; Godot エディタの「プロジェクト設定」で変えた内容がここに保存されます。

config_version=5

[application]

config/name="Freedom Land"
config/description="みんなで遊べるオリジナル3Dミニゲーム集"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; Net はどの画面からでも使える「ネットワーク係」です(scripts/net.gd)。
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
; ブラウザ版(スマホ)では、軽くて対応している機種が多い「Compatibility」で描く
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d.web=0
textures/vram_compression/import_etc2_astc=true

[input_devices]

; スマホでは、画面のタッチをマウスのクリックとしても扱う(ボタンを押せるように)
pointing/emulate_mouse_from_touch=true

[gui]

; ボタンや文字に使うフォント(日本語入り)。ブラウザ版にはパソコンのフォントがないので必須
theme/custom_font="res://fonts/MPLUSRounded1c-Bold.ttf"
